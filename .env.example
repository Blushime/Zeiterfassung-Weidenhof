# In .env kopieren und ausfüllen (nie committen — .env ist gitignored)

# 64-stelliges Hex-Secret, z. B.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# Oeffentlicher Domain-Name der App (DNS-A-Record muss auf den Server zeigen)
DOMAIN=zeiterfassung.example.de

# Optional: statt SQLite PostgreSQL nutzen (z. B. postgres://user:pass@db:5432/zeiterfassung)
# DATABASE_URL=
